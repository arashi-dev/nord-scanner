{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nord Scanner",
  "version": "0.1.0",
  "identifier": "com.nordscanner.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nord Scanner",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NDEzN0NBOUUyMDM5RTkKUldRa3RhL01uV085K0R0Q2tQeGpuVW44dkt5MllYTE10NW5wZ2NqUW9nND0=",
      "endpoints": [
        "https://github.com/your-org/nord-scanner/releases/latest/download/latest.json"
      ]
    }
  }
}
